# Backend (apps/api)
PORT=8787
NODE_ENV=development

# DynamoDB (local dev via Docker)
DDB_ENDPOINT=http://localhost:8000
DDB_TABLE=linguadev-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# IA (opcional; en producción viene de SSM Parameter Store)
# Elige un provider: anthropic | openai | deepseek | bedrock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# DeepSeek — proveedor chino, precio muy bajo, compatible OpenAI
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
BEDROCK_MODEL_ID=

# Presupuesto/rate-limit
AI_DAILY_BUDGET_USD=1.00
AI_RATE_LIMIT_PER_MIN=20

# Frontend (apps/web) — nunca poner secrets aquí
VITE_API_BASE=http://localhost:8787
