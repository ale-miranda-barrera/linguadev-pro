{
  "name": "linguadev-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules",
    "ddb:up": "docker compose -f docker/docker-compose.yml up -d dynamodb",
    "ddb:down": "docker compose -f docker/docker-compose.yml down",
    "ddb:seed": "node scripts/seed-ddb.mjs",
    "sam:build": "sam build --template infra/template.yaml",
    "sam:deploy": "sam deploy --template infra/template.yaml --guided",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
